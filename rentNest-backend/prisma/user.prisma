model User {
  id             String          @id @default(uuid()) @db.Uuid
  email          String          @unique
  password       String
  role           UserRole        @default(TENANT)
  status         UserStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  profile        Profile?
  properties     Property[]
  rentalRequests RentalRequest[]
  reviews        Review[]

  @@map("users")
}

enum UserRole {
  TENANT
  LANDLORD
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}