model Profile{
    id String @id @default(uuid()) @db.Uuid
    userId String @unique @db.Uuid
    user User @relation(fields: [userId],references: [id], onDelete: Cascade)
    name String
    phone String?
    address String?
    profileImage String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("profiles")
}